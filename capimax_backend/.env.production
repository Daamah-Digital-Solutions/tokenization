# USE_S3_STORAGE=True
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=capimax-media
# AWS_S3_REGION_NAME=eu-west-1
# AWS_S3_CUSTOM_DOMAIN=

# -----------------------------------------------------------------------------
