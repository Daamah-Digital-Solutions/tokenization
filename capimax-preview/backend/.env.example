# Server Configuration
NODE_ENV=development
PORT=3001
API_VERSION=v1

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/capimax_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=capimax_dev
DB_USER=user
DB_PASSWORD=password
DB_SSL=false

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-256-bits-minimum
JWT_REFRESH_SECRET=your-super-secure-refresh-secret-key-256-bits
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Encryption
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@capimax.com

# SendGrid (Alternative)
SENDGRID_API_KEY=your-sendgrid-api-key

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=capimax-documents-dev

# Payment Provider Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# Blockchain Configuration
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your-infura-key
ETHEREUM_TESTNET_RPC_URL=https://goerli.infura.io/v3/your-infura-key
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_TESTNET_RPC_URL=https://rpc-mumbai.maticvigil.com

# Platform Wallet Configuration (Encrypted Private Keys)
PLATFORM_PRIVATE_KEY=your-encrypted-private-key
PLATFORM_WALLET_ADDRESS=0xYourPlatformWalletAddress

# Smart Contract Addresses
PROPERTY_TOKEN_FACTORY=0xYourPropertyTokenFactoryAddress
INVESTMENT_ESCROW=0xYourInvestmentEscrowAddress

# External API Keys
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
COINMARKETCAP_API_KEY=your-coinmarketcap-api-key

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=1800000

# KYC/AML Configuration
KYC_DOCUMENT_EXPIRY_DAYS=365
AML_CHECK_ENABLED=true
SANCTIONS_CHECK_ENABLED=true

# Notification Configuration
PUSH_NOTIFICATION_KEY=your-push-notification-key
SLACK_WEBHOOK_URL=your-slack-webhook-url

# Monitoring and Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log
SENTRY_DSN=your-sentry-dsn

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true