# Capimax STAGING environment variables.
# Copy to .env on the VPS and fill in the empty values. NEVER commit the
# filled-in .env — it contains secrets.
#
# Located on the VPS at: /docker/staging/.env

# -----------------------------------------------------------------------
# Django core
# -----------------------------------------------------------------------
ENVIRONMENT=staging
DEBUG=False
SECRET_KEY=__REPLACE_WITH_A_50_CHAR_RANDOM_STRING__
ALLOWED_HOSTS=capimaxrt.tech,www.capimaxrt.tech,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://capimaxrt.tech,https://www.capimaxrt.tech
CORS_ALLOWED_ORIGINS=https://capimaxrt.tech,https://www.capimaxrt.tech

# Optional: git ref to deploy. Defaults to main.
GIT_REF=main

# Optional: initial superuser password. Change immediately after first login.
ADMIN_INITIAL_PASSWORD=ChangeMeNow2026!

# -----------------------------------------------------------------------
# Database (managed by the staging postgres container)
# -----------------------------------------------------------------------
POSTGRES_DB=capimax_staging
POSTGRES_USER=capimax_staging_user
POSTGRES_PASSWORD=__REPLACE_WITH_A_STRONG_PASSWORD__
DATABASE_URL=postgresql://capimax_staging_user:__REPLACE_WITH_A_STRONG_PASSWORD__@db:5432/capimax_staging

# -----------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------
# Email — Hostinger SMTP. Fill EMAIL_HOST_PASSWORD with your real password.
# -----------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=noreply@capimaxrt.tech
EMAIL_HOST_PASSWORD=__REPLACE_WITH_HOSTINGER_SMTP_PASSWORD__
DEFAULT_FROM_EMAIL=Capimax <noreply@capimaxrt.tech>

# -----------------------------------------------------------------------
# Stripe (test mode keys — safe to use on staging)
# -----------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------
# Frontend build-time env (injected by frontend_builder into the React bundle)
# -----------------------------------------------------------------------
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_GOOGLE_CLIENT_ID=
VITE_WALLET_CONNECT_PROJECT_ID=

# -----------------------------------------------------------------------
# Blockchain — BSC Testnet (chain 97)
# -----------------------------------------------------------------------
ETHEREUM_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/demo
POLYGON_RPC_URL=
BNB_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

DEFAULT_CHAIN_ID=97
DEFAULT_NETWORK_NAME=bsc_testnet
CONTRACT_FACTORY_ADDRESS=0x4B5301C45B876F4197F3Fc25b7e4dE062382F651
REAL_ESTATE_TOKEN_TEMPLATE=0xd186eFAF6D38ac2225eDaC43DB4Be1db6aFE6B14
RENTAL_DISTRIBUTOR_TEMPLATE=0x95F3D62Bc0F637F16428665f602BF316863EFD6c
PLATFORM_TREASURY_ADDRESS=0x9278A652585779935F7FDbD6D1259f327B12AfD0

# Deployer / platform-signer private key. KEEP SECRET.
DEPLOYER_PRIVATE_KEY=__REPLACE_WITH_DEPLOYER_PRIVATE_KEY__
BLOCKCHAIN_PRIVATE_KEY=__REPLACE_WITH_DEPLOYER_PRIVATE_KEY__

# -----------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------
ENABLE_2FA=True
ENABLE_CRYPTO_PAYMENTS=True
